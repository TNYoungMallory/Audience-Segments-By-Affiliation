SET ansi_mode = false;


-- ============================================================
-- STEP 1: Create table on first run
--
-- Grain:
--   1 row per logged-in prospect (amgid)
--   per visit_date
--   per source
--
-- Historical rows are retained permanently.
-- ============================================================

CREATE TABLE IF NOT EXISTS gold_us_prod.area_shared_analytics.logged_in_prospects_tny (

  visit_date DATE,
  entitlement_status STRING,
  source STRING,
  amgid STRING,
  amgid_stitched STRING,
  xid STRING

);


-- ============================================================
-- STEP 2: Build current logged-in subsctiber / non-trial universe
--
-- Identifies users who are NOT currently subscribers
-- and NOT currently in trial.
--
-- This universe is used ONLY to determine who is eligible
-- to have new activity added during today's refresh.
--
-- It does NOT affect historical rows already in the table.
-- ============================================================

CREATE OR REPLACE TEMP VIEW eligible_users AS

WITH current_subscribers AS (

    SELECT DISTINCT
      email_md5_hash
    FROM gold_us_prod.consumer_dw.f_consumer_subscription_cds
    WHERE core_brand_cd IN ('TNY', 'NYR')
      AND email_md5_hash IS NOT NULL
      AND (
        order_expire_dt >= CURRENT_DATE
        OR cancel_dt >= CURRENT_DATE
      )
),

current_trials AS (

    SELECT DISTINCT
      email_md5_hash
    FROM gold_us_prod.consumer_dw.f_consumer_subscription_martech
    WHERE core_brand_cd IN ('TNY', 'NYR')
      AND trial_start_dt IS NOT NULL
      AND trial_end_dt IS NOT NULL
      AND CURRENT_DATE BETWEEN DATE(trial_start_dt) AND DATE(trial_end_dt)
),

email_map AS (

    SELECT DISTINCT
      amg_uuid AS amgid,
      email_md5_hash
    FROM gold_us_prod.consumer_dw.d_email_extd
    WHERE amg_uuid IS NOT NULL
      AND email_md5_hash IS NOT NULL
)

SELECT DISTINCT
  e.amgid
FROM email_map e
LEFT JOIN current_subscribers s
  ON e.email_md5_hash = s.email_md5_hash
LEFT JOIN current_trials t
  ON e.email_md5_hash = t.email_md5_hash
WHERE s.email_md5_hash IS NULL
  AND t.email_md5_hash IS NULL;


-- ============================================================
-- STEP 3: Build daily engagement and merge
--
-- WEB:
--   One row per amgid + visit_date
--
-- MOBILE:
--   One row per amgid + visit_date
--
-- The 3-day lookback allows the daily process to safely
-- reprocess recent dates.
--
-- Historical rows already in the table are never deleted.
-- ============================================================

WITH web_ranked AS (

    SELECT

      start_tstamp_date AS visit_date,

      COALESCE(
        user.amg_id_stitched,
        user.amgid
      ) AS amgid,

      user.amg_id_stitched AS amgid_stitched,

      user.xid AS xid,

      ROW_NUMBER() OVER (

        PARTITION BY
          start_tstamp_date,
          COALESCE(user.amg_id_stitched, user.amgid)

        ORDER BY
          start_tstamp DESC

      ) AS rn

    FROM gold_us_prod.spruce.gld_web_page_views

    WHERE start_tstamp_date BETWEEN CURRENT_DATE - 3
                                AND CURRENT_DATE - 1

      AND app_id = 'the-new-yorker'

      AND COALESCE(user.amg_id_stitched, user.amgid) IS NOT NULL

      AND domain_userid IS NOT NULL
),


web_daily AS (

    SELECT

      visit_date,
      amgid,
      amgid_stitched,
      xid,
      'web' AS source

    FROM web_ranked

    WHERE rn = 1
),


mobile_daily AS (

    SELECT

      derived_tstamp_date AS visit_date,

      user.amg_id AS amgid,

      NULL AS amgid_stitched,

      NULL AS xid,

      'mobile' AS source

    FROM gold_us_prod.spruce.gld_mobile_screen_views

    WHERE derived_tstamp_date BETWEEN CURRENT_DATE - 3
                                  AND CURRENT_DATE - 1

      AND app_id = 'the-new-yorker-app'

      AND user.amg_id IS NOT NULL

    GROUP BY

      derived_tstamp_date,
      user.amg_id
),


daily_engagement AS (

    SELECT

      visit_date,
      amgid,
      amgid_stitched,
      xid,
      source

    FROM web_daily

    UNION ALL

    SELECT

      visit_date,
      amgid,
      amgid_stitched,
      xid,
      source

    FROM mobile_daily
),


-- ============================================================
-- STEP 4: Keep only engagement from eligible users
-- (logged-in prospect, non-trials)
--
-- This determines eligibility for NEW rows only.
--
-- If a user later subscribes or stops taking action,
-- their existing historical rows remain in the table.
-- ============================================================

new_rows AS (

    SELECT

      d.visit_date,

      'logged-in prospect' AS entitlement_status,

      d.source,

      d.amgid,

      d.amgid_stitched,

      d.xid

    FROM daily_engagement d

    INNER JOIN eligible_users eu
      ON d.amgid = eu.amgid
)


-- ============================================================
-- STEP 5: Merge daily engagement into historical table
--
-- Grain:
--   visit_date + amgid + source
--
-- If the row already exists:
--   Update identifiers when a newer/better value is available.
--
-- If the row does not exist:
--   Insert it.
--
-- IMPORTANT:
--   There is intentionally NO DELETE step.
--   Historical activity is retained permanently.
-- ============================================================

MERGE INTO gold_us_prod.area_shared_analytics.logged_in_prospects_tny t

USING new_rows s

ON t.visit_date = s.visit_date

   AND t.amgid = s.amgid

   AND t.source = s.source


WHEN MATCHED THEN

  UPDATE SET

    t.amgid_stitched =
      COALESCE(
        s.amgid_stitched,
        t.amgid_stitched
      ),

    t.xid =
      COALESCE(
        s.xid,
        t.xid
      )


WHEN NOT MATCHED THEN

  INSERT (
    visit_date,
    entitlement_status,
    source,
    amgid,
    amgid_stitched,
    xid
  )

  VALUES (
    s.visit_date,
    s.entitlement_status,
    s.source,
    s.amgid,
    s.amgid_stitched,
    s.xid
  );
