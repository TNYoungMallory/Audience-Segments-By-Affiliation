SET ansi_mode = false;

-- Step 1: Create table on first run (no-op after that)
CREATE TABLE IF NOT EXISTS hive_metastore.default.web_app_visitors_tny (
  visit_date DATE,
  entitlement_status STRING,
  source STRING,
  amgid STRING,
  amgid_stitched STRING,
  xid STRING,
  upvid STRING
);

-- Step 2: Remove users no longer cross-platform or visits outside the 3-month window
WITH web_visits_3m AS (
  SELECT DISTINCT COALESCE(user.amg_id_stitched, user.amgid) AS amg_id
  FROM gold_us_prod.spruce.gld_web_page_views
  WHERE start_tstamp_date >= ADD_MONTHS(DATE_TRUNC('month', CURRENT_DATE), -3)
    AND start_tstamp_date < CURRENT_DATE
    AND app_id IN ('the-new-yorker', 'the-new-yorker-app')
    AND COALESCE(user.amg_id_stitched, user.amgid) IS NOT NULL
    AND isnotnull(domain_userid)
),
mobile_visits_3m AS (
  SELECT DISTINCT user.amg_id AS amg_id
  FROM gold_us_prod.spruce.gld_mobile_screen_views
  WHERE derived_tstamp_date >= ADD_MONTHS(DATE_TRUNC('month', CURRENT_DATE), -3)
    AND derived_tstamp_date < CURRENT_DATE
    AND app_id = 'the-new-yorker-app'
    AND isnotnull(user.amg_id)
),
current_cross_platform AS (
  SELECT w.amg_id
  FROM web_visits_3m w
  INNER JOIN mobile_visits_3m m ON w.amg_id = m.amg_id
)
DELETE FROM hive_metastore.default.web_app_visitors_tny
WHERE visit_date < ADD_MONTHS(DATE_TRUNC('month', CURRENT_DATE), -3)
   OR amgid NOT IN (SELECT amg_id FROM current_cross_platform);

-- Step 3: Add new cross-platform visitor rows (3-day lookback; MERGE prevents duplicates)
WITH
web_raw AS (
  SELECT
    COALESCE(user.amg_id_stitched, user.amgid) AS amg_id,
    start_tstamp_date AS visit_date,
    user.amg_id_stitched AS amg_id_stitched,
    user.xid AS xid,
    concat(domain_sessionid, concat(PAGE.url_scheme, '://', PAGE.url_host, PAGE.url_path)) AS upvid,
    'web' AS source
  FROM gold_us_prod.spruce.gld_web_page_views
  WHERE start_tstamp_date BETWEEN current_date - 3 AND current_date - 1
    AND app_id IN ('the-new-yorker', 'the-new-yorker-app')
    AND COALESCE(user.amg_id_stitched, user.amgid) IS NOT NULL
    AND isnotnull(domain_userid)
),

mobile_raw AS (
  SELECT
    user.amg_id AS amg_id,
    derived_tstamp_date AS visit_date,
    NULL AS amg_id_stitched,
    NULL AS xid,
    screen_view_id AS upvid,
    'mobile' AS source
  FROM gold_us_prod.spruce.gld_mobile_screen_views
  WHERE derived_tstamp_date BETWEEN current_date - 3 AND current_date - 1
    AND app_id = 'the-new-yorker-app'
    AND isnotnull(user.amg_id)
),

/* Cross-platform determination uses full 3-month window */
web_visits_3m AS (
  SELECT DISTINCT COALESCE(user.amg_id_stitched, user.amgid) AS amg_id, start_tstamp_date AS visit_date
  FROM gold_us_prod.spruce.gld_web_page_views
  WHERE start_tstamp_date >= ADD_MONTHS(DATE_TRUNC('month', CURRENT_DATE), -3)
    AND start_tstamp_date < CURRENT_DATE
    AND app_id IN ('the-new-yorker', 'the-new-yorker-app')
    AND COALESCE(user.amg_id_stitched, user.amgid) IS NOT NULL
    AND isnotnull(domain_userid)
),

mobile_visits_3m AS (
  SELECT DISTINCT user.amg_id AS amg_id, derived_tstamp_date AS visit_date
  FROM gold_us_prod.spruce.gld_mobile_screen_views
  WHERE derived_tstamp_date >= ADD_MONTHS(DATE_TRUNC('month', CURRENT_DATE), -3)
    AND derived_tstamp_date < CURRENT_DATE
    AND app_id = 'the-new-yorker-app'
    AND isnotnull(user.amg_id)
),

cross_platform AS (
  SELECT DISTINCT w.amg_id
  FROM (SELECT DISTINCT amg_id FROM web_visits_3m) w
  INNER JOIN (SELECT DISTINCT amg_id FROM mobile_visits_3m) m ON w.amg_id = m.amg_id
),

/* Returning visitor: visited in each of the 3 complete calendar months before current month */
combined_visits_3m AS (
  SELECT amg_id, visit_date FROM web_visits_3m
  UNION ALL
  SELECT amg_id, visit_date FROM mobile_visits_3m
),

returning_visitors AS (
  SELECT amg_id
  FROM combined_visits_3m
  WHERE visit_date >= ADD_MONTHS(DATE_TRUNC('month', CURRENT_DATE), -3)
    AND visit_date < DATE_TRUNC('month', CURRENT_DATE)
  GROUP BY amg_id
  HAVING COUNT(DISTINCT DATE_TRUNC('month', visit_date)) >= 3
),

/* Identity bridge */
email_map AS (
  SELECT DISTINCT amg_uuid AS amg_id, email_md5_hash
  FROM gold_us_prod.consumer_dw.d_email_extd
  WHERE amg_uuid IS NOT NULL AND email_md5_hash IS NOT NULL
),

/* Subscription records — CDS */
cds_subs AS (
  SELECT
    email_md5_hash,
    CAST(COALESCE(cancel_dt, order_expire_dt) AS DATE) AS sub_last_active_dt,
    FALSE AS is_trial,
    ROW_NUMBER() OVER (
      PARTITION BY email_md5_hash, magazine_abbr, order_expire_dt
      ORDER BY order_nbr DESC
    ) AS rn
  FROM gold_us_prod.consumer_dw.f_consumer_subscription_cds
  WHERE brand_cd IN ('NYR', 'NYR3')
),

/* Subscription records — Martech */
martech_subs AS (
  SELECT
    email_md5_hash,
    CAST(IFNULL(sub_cancelled_dt, CURRENT_TIMESTAMP) AS DATE) AS sub_last_active_dt,
    CASE
      WHEN trial_start_dt IS NOT NULL
        AND CAST(trial_end_dt AS DATE) >= CURRENT_DATE THEN TRUE
      ELSE FALSE
    END AS is_trial
  FROM gold_us_prod.consumer_dw.f_consumer_subscription_martech
  WHERE core_brand_cd IN ('TNY', 'NYR')
),

all_subs AS (
  SELECT email_md5_hash, sub_last_active_dt, is_trial FROM cds_subs WHERE rn = 1
  UNION ALL
  SELECT email_md5_hash, sub_last_active_dt, is_trial FROM martech_subs
),

sub_summary AS (
  SELECT
    email_md5_hash,
    MAX(CASE WHEN sub_last_active_dt >= CURRENT_DATE THEN 1 ELSE 0 END) AS is_active,
    MAX(CASE WHEN sub_last_active_dt >= CURRENT_DATE AND is_trial = TRUE THEN 1 ELSE 0 END) AS is_in_trial,
    MAX(CASE WHEN sub_last_active_dt < CURRENT_DATE THEN sub_last_active_dt END) AS last_expired_dt
  FROM all_subs
  GROUP BY email_md5_hash
),

user_profile AS (
  SELECT
    cp.amg_id,
    em.email_md5_hash,
    ss.is_active,
    ss.is_in_trial,
    CASE
      WHEN ss.is_active = 0 OR ss.is_active IS NULL
      THEN DATEDIFF(CURRENT_DATE, ss.last_expired_dt)
    END AS days_since_expired,
    CASE WHEN rv.amg_id IS NOT NULL THEN TRUE ELSE FALSE END AS is_returning_visitor
  FROM cross_platform cp
  LEFT JOIN email_map em ON cp.amg_id = em.amg_id
  LEFT JOIN sub_summary ss ON em.email_md5_hash = ss.email_md5_hash
  LEFT JOIN returning_visitors rv ON cp.amg_id = rv.amg_id
  QUALIFY ROW_NUMBER() OVER (
    PARTITION BY cp.amg_id
    ORDER BY
      ss.is_active DESC NULLS LAST,
      ss.is_in_trial DESC NULLS LAST,
      ss.last_expired_dt DESC NULLS LAST
  ) = 1
),

classified AS (
  SELECT
    amg_id,
    CASE
      WHEN is_active = 1 AND is_in_trial = 1 THEN 'Subscriber in Trial'
      WHEN is_active = 1 THEN 'Subscriber'
      WHEN is_returning_visitor = TRUE AND (is_active = 0 OR is_active IS NULL) THEN 'Returning Visitor'
      WHEN days_since_expired <= 90 THEN 'Former Subscriber — Lapsed <=3 Months'
      WHEN days_since_expired > 90 THEN 'Former Subscriber — Lapsed >3 Months'
      WHEN email_md5_hash IS NOT NULL THEN 'Logged In Prospect'
      ELSE 'Anonymous'
    END AS entitlement
  FROM user_profile
),

new_rows AS (
  SELECT
    rv.visit_date,
    c.entitlement AS entitlement_status,
    rv.source,
    rv.amg_id AS amgid,
    rv.amg_id_stitched AS amgid_stitched,
    rv.xid,
    rv.upvid
  FROM classified c
  INNER JOIN (
    SELECT amg_id, visit_date, source, amg_id_stitched, xid, upvid FROM web_raw
    UNION ALL
    SELECT amg_id, visit_date, source, amg_id_stitched, xid, upvid FROM mobile_raw
  ) rv ON c.amg_id = rv.amg_id
  GROUP BY ALL
)
MERGE INTO hive_metastore.default.web_app_visitors_tny t
USING new_rows s
ON t.visit_date = s.visit_date
   AND t.amgid = s.amgid
   AND t.source = s.source
   AND (t.amgid_stitched <=> s.amgid_stitched)
   AND (t.xid <=> s.xid)
   AND (t.upvid <=> s.upvid)
WHEN NOT MATCHED THEN INSERT *;
