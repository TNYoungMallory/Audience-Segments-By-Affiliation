SET ansi_mode = false;

-- ============================================================
-- STEP 1: Create table on first run
--
-- Grain:
--   1 row per visitor
--   per visit_date
--   per source
--
-- Historical qualifying activity is retained.
-- Entitlement status does NOT determine qualification.
-- ============================================================

CREATE TABLE IF NOT EXISTS gold_us_prod.area_shared_analytics.web_app_visitors_tny (

  visit_date DATE,
  entitlement_status STRING,
  source STRING,
  amgid STRING,
  amgid_stitched STRING,
  xid STRING

);


-- ============================================================
-- STEP 2: Build web activity for the rolling ~90-day window
-- ============================================================

WITH web_visits_90d AS (

  SELECT DISTINCT
    COALESCE(user.amg_id_stitched, user.amgid) AS amg_id,
    start_tstamp_date AS visit_date,
    user.amg_id_stitched AS amg_id_stitched,
    user.xid AS xid,
    'web' AS source

  FROM gold_us_prod.spruce.gld_web_page_views

  WHERE start_tstamp_date >= CURRENT_DATE - INTERVAL 90 DAYS
    AND start_tstamp_date < CURRENT_DATE

    AND app_id IN (
      'the-new-yorker',
      'the-new-yorker-app'
    )

    AND COALESCE(user.amg_id_stitched, user.amgid) IS NOT NULL

    -- Logged-in / consented web users
    AND isnotnull(domain_userid)

),


-- ============================================================
-- STEP 3: Build app activity for the rolling ~90-day window
-- ============================================================

mobile_visits_90d AS (

  SELECT DISTINCT
    user.amg_id AS amg_id,
    derived_tstamp_date AS visit_date,
    CAST(NULL AS STRING) AS amg_id_stitched,
    CAST(NULL AS STRING) AS xid,
    'mobile' AS source

  FROM gold_us_prod.spruce.gld_mobile_screen_views

  WHERE derived_tstamp_date >= CURRENT_DATE - INTERVAL 90 DAYS
    AND derived_tstamp_date < CURRENT_DATE

    AND app_id = 'the-new-yorker-app'

    AND user.amg_id IS NOT NULL

),


-- ============================================================
-- STEP 4: Determine which users used BOTH web and app
-- within the SAME calendar month.
--
-- A user qualifies if there is at least one calendar month
-- in the rolling 90-day window where they used both platforms.
-- ============================================================

monthly_platform_usage AS (

  SELECT
    amg_id,
    DATE_TRUNC('month', visit_date) AS visit_month,
    MAX(CASE WHEN source = 'web' THEN 1 ELSE 0 END) AS used_web,
    MAX(CASE WHEN source = 'mobile' THEN 1 ELSE 0 END) AS used_app

  FROM (

    SELECT
      amg_id,
      visit_date,
      source
    FROM web_visits_90d

    UNION ALL

    SELECT
      amg_id,
      visit_date,
      source
    FROM mobile_visits_90d

  ) x

  GROUP BY
    amg_id,
    DATE_TRUNC('month', visit_date)

),


-- ============================================================
-- STEP 5: Current cross-platform audience
--
-- User qualifies if they used both web and app in at least
-- one calendar month during the rolling 90-day window.
-- ============================================================

current_cross_platform AS (

  SELECT DISTINCT
    amg_id

  FROM monthly_platform_usage

  WHERE used_web = 1
    AND used_app = 1

),


-- ============================================================
-- STEP 6: Identity bridge
-- ============================================================

email_map AS (

  SELECT DISTINCT
    amg_uuid AS amg_id,
    email_md5_hash

  FROM gold_us_prod.consumer_dw.d_email_extd

  WHERE amg_uuid IS NOT NULL
    AND email_md5_hash IS NOT NULL

),


-- ============================================================
-- STEP 7: Subscription records
--
-- Used ONLY to classify entitlement.
-- Subscription status has NO impact on whether the user
-- qualifies as a cross-platform visitor.
-- ============================================================

cds_subs AS (

  SELECT
    email_md5_hash,

    CAST(
      COALESCE(cancel_dt, order_expire_dt)
      AS DATE
    ) AS sub_last_active_dt,

    FALSE AS is_trial,

    ROW_NUMBER() OVER (
      PARTITION BY
        email_md5_hash,
        magazine_abbr,
        order_expire_dt
      ORDER BY order_nbr DESC
    ) AS rn

  FROM gold_us_prod.consumer_dw.f_consumer_subscription_cds

  WHERE brand_cd IN ('NYR', 'NYR3')

),


martech_subs AS (

  SELECT
    email_md5_hash,

    CAST(
      IFNULL(sub_cancelled_dt, CURRENT_TIMESTAMP)
      AS DATE
    ) AS sub_last_active_dt,

    CASE
      WHEN trial_start_dt IS NOT NULL
       AND CAST(trial_end_dt AS DATE) >= CURRENT_DATE
      THEN TRUE
      ELSE FALSE
    END AS is_trial

  FROM gold_us_prod.consumer_dw.f_consumer_subscription_martech

  WHERE core_brand_cd IN ('TNY', 'NYR')

),


all_subs AS (

  SELECT
    email_md5_hash,
    sub_last_active_dt,
    is_trial

  FROM cds_subs

  WHERE rn = 1

  UNION ALL

  SELECT
    email_md5_hash,
    sub_last_active_dt,
    is_trial

  FROM martech_subs

),


sub_summary AS (

  SELECT
    email_md5_hash,

    MAX(
      CASE
        WHEN sub_last_active_dt >= CURRENT_DATE
        THEN 1
        ELSE 0
      END
    ) AS is_active,

    MAX(
      CASE
        WHEN sub_last_active_dt >= CURRENT_DATE
         AND is_trial = TRUE
        THEN 1
        ELSE 0
      END
    ) AS is_in_trial,

    MAX(
      CASE
        WHEN sub_last_active_dt < CURRENT_DATE
        THEN sub_last_active_dt
      END
    ) AS last_expired_dt

  FROM all_subs

  GROUP BY email_md5_hash

),


-- ============================================================
-- STEP 8: Classify current cross-platform users
--
-- IMPORTANT:
-- Qualification has already been determined by
-- current_cross_platform.
--
-- Entitlement is simply an attribute.
-- ============================================================

user_profile AS (

  SELECT
    cp.amg_id,
    em.email_md5_hash,
    ss.is_active,
    ss.is_in_trial,

    CASE
      WHEN ss.is_active = 0
        OR ss.is_active IS NULL
      THEN DATEDIFF(
        CURRENT_DATE,
        ss.last_expired_dt
      )
    END AS days_since_expired

  FROM current_cross_platform cp

  LEFT JOIN email_map em
    ON cp.amg_id = em.amg_id

  LEFT JOIN sub_summary ss
    ON em.email_md5_hash = ss.email_md5_hash

  QUALIFY ROW_NUMBER() OVER (
    PARTITION BY cp.amg_id
    ORDER BY
      ss.is_active DESC NULLS LAST,
      ss.is_in_trial DESC NULLS LAST,
      ss.last_expired_dt DESC NULLS LAST
  ) = 1

),


classified AS (

  SELECT
    amg_id,

    CASE
      WHEN is_active = 1
       AND is_in_trial = 1
        THEN 'Subscriber in Trial'

      WHEN is_active = 1
        THEN 'Subscriber'

      WHEN days_since_expired <= 90
        THEN 'Former Subscriber — Lapsed <=3 Months'

      WHEN days_since_expired > 90
        THEN 'Former Subscriber — Lapsed >3 Months'

      WHEN email_md5_hash IS NOT NULL
        THEN 'Logged In Prospect'

      ELSE 'Anonymous'

    END AS entitlement

  FROM user_profile

),


-- ============================================================
-- STEP 9: Only bring in recent activity.
--
-- The 90-day window determines whether someone currently
-- qualifies.
--
-- The 3-day lookback captures newly arrived activity.
-- ============================================================

new_rows AS (

  SELECT
    v.visit_date,
    c.entitlement AS entitlement_status,
    v.source,
    v.amg_id AS amgid,
    v.amg_id_stitched AS amgid_stitched,
    v.xid

  FROM classified c

  INNER JOIN (

    SELECT
      amg_id,
      visit_date,
      source,
      amg_id_stitched,
      xid

    FROM web_visits_90d

    WHERE visit_date >= CURRENT_DATE - INTERVAL 3 DAYS

    UNION ALL

    SELECT
      amg_id,
      visit_date,
      source,
      amg_id_stitched,
      xid

    FROM mobile_visits_90d

    WHERE visit_date >= CURRENT_DATE - INTERVAL 3 DAYS

  ) v

    ON c.amg_id = v.amg_id

  GROUP BY ALL

)


-- ============================================================
-- STEP 10: Add new daily activity.
--
-- No DELETE.
--
-- Historical rows remain even after a visitor stops
-- qualifying.
-- ============================================================

MERGE INTO gold_us_prod.area_shared_analytics.web_app_visitors_tny t

USING new_rows s

ON t.visit_date = s.visit_date
AND t.amgid = s.amgid
AND t.source = s.source
AND (t.amgid_stitched <=> s.amgid_stitched)
AND (t.xid <=> s.xid)

WHEN NOT MATCHED THEN

  INSERT (
    visit_date,
    entitlement_status,
    source,
    amgid,
    amgid_stitched,
    xid
  )

  VALUES (
    s.visit_date,
    s.entitlement_status,
    s.source,
    s.amgid,
    s.amgid_stitched,
    s.xid
  );
