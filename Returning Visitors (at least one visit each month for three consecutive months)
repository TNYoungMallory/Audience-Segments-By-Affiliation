SET ansi_mode = false;

-- ============================================================
-- Step 1: Create table on first run
-- ============================================================

CREATE TABLE IF NOT EXISTS gold_us_prod.area_shared_analytics.returning_visitors_tny (
  visit_date DATE,
  entitlement_status STRING,
  source STRING,
  xid STRING
);


-- ============================================================
-- Step 2: Subscriber exclusion universe
-- Applies to BOTH web and mobile
-- ============================================================

WITH active_sub_duids AS (

  SELECT DISTINCT
    aim.domain_userid

  FROM gold_us_prod.spruce.analytics_identity_map aim

  INNER JOIN gold_us_prod.consumer_dw.d_email_extd ext
    ON aim.amg_user_id = ext.amg_uuid

  INNER JOIN gold_us_prod.consumer_dw.f_consumer_subscription_martech sub
    ON sub.consumer_profile_key = ext.email_md5_hash
    AND sub.brand_cd = 'NYR'
    AND sub.sub_status IN (
      'active',
      'in_trial',
      'non_renewing'
    )

  WHERE aim.brand = 'The New Yorker'
    AND aim.domain_userid IS NOT NULL
),


-- ============================================================
-- Step 3: Daily visitors to evaluate
--
-- These are the visitors whose activity we are loading.
-- ============================================================

pvs AS (

  -- WEB
  SELECT
    start_tstamp_date AS visit_date,
    domain_userid AS user_id,
    user.xid AS xid,
    'web' AS source

  FROM gold_us_prod.spruce.gld_web_page_views

  WHERE start_tstamp_date BETWEEN
        current_date - 3
        AND current_date - 1

    AND domain_userid IS NOT NULL

    AND app_id IN (
      'the-new-yorker',
      'the-new-yorker-app'
    )

    AND user.amgid IS NULL

    -- Exclude paid traffic
    AND NOT (
      lower(session.marketing_source) LIKE '%jg%'
      OR lower(session.marketing_source) LIKE '%display%'
      OR lower(session.marketing_medium) LIKE '%display%'
      OR lower(session.marketing_campaign) LIKE 'paid%'
      OR lower(session.marketing_campaign) LIKE '%paid-revops%'
      OR lower(session.marketing_campaign) LIKE 'tin_%'
      OR lower(session.marketing_medium) LIKE 'paid%'
      OR lower(session.referer_url_query) LIKE '%boosted%'
      OR lower(session.referer_url_query) LIKE '%facebook-citizennet%'
      OR lower(session.marketing_medium) LIKE 'cpc%'
    )

    AND domain_userid NOT IN (
      SELECT domain_userid
      FROM active_sub_duids
    )


  UNION ALL


  -- MOBILE
  SELECT
    derived_tstamp_date AS visit_date,
    user.user_id AS user_id,
    CAST(NULL AS STRING) AS xid,
    'mobile' AS source

  FROM gold_us_prod.spruce.gld_mobile_screen_views

  WHERE derived_tstamp_date BETWEEN
        current_date - 3
        AND current_date - 1

    AND app_id = 'the-new-yorker-app'

    AND user.user_id IS NOT NULL

    -- Exclude subscribers from mobile
    AND user.user_id NOT IN (
      SELECT domain_userid
      FROM active_sub_duids
    )

    -- Exclude paid traffic
    AND NOT (
      traffic.source_channel_group IN (
        'Paid Social',
        'Paid Search'
      )
      OR lower(traffic.marketing_campaign) LIKE 'paid%'
      OR lower(traffic.referrer_medium) LIKE '%display%'
    )
),


-- ============================================================
-- Step 4: Build visitor activity history
--
-- We pull 90 days BEFORE the earliest visit_date we are
-- evaluating, plus the visit date itself.
--
-- This gives us enough history to evaluate each visit_date
-- independently.
-- ============================================================

visitor_activity AS (

  -- WEB
  SELECT DISTINCT
    domain_userid AS user_id,
    start_tstamp_date AS activity_date,
    DATE_TRUNC(
      'month',
      start_tstamp_date
    ) AS activity_month

  FROM gold_us_prod.spruce.gld_web_page_views

  WHERE start_tstamp_date BETWEEN
        (
          SELECT MIN(visit_date)
          FROM pvs
        ) - 89
        AND (
          SELECT MAX(visit_date)
          FROM pvs
        )

    AND domain_userid IS NOT NULL

    AND app_id IN (
      'the-new-yorker',
      'the-new-yorker-app'
    )

    AND domain_userid NOT IN (
      SELECT domain_userid
      FROM active_sub_duids
    )


  UNION


  -- MOBILE
  SELECT DISTINCT
    user.user_id AS user_id,
    derived_tstamp_date AS activity_date,
    DATE_TRUNC(
      'month',
      derived_tstamp_date
    ) AS activity_month

  FROM gold_us_prod.spruce.gld_mobile_screen_views

  WHERE derived_tstamp_date BETWEEN
        (
          SELECT MIN(visit_date)
          FROM pvs
        ) - 89
        AND (
          SELECT MAX(visit_date)
          FROM pvs
        )

    AND user.user_id IS NOT NULL

    AND app_id = 'the-new-yorker-app'

    AND user.user_id NOT IN (
      SELECT domain_userid
      FROM active_sub_duids
    )
),


-- ============================================================
-- Step 5: Determine whether each daily visitor qualifies
--
-- For EACH visit_date:
--
--   visit_date - 89 days
--          through
--   visit_date
--
-- must contain activity in >= 3 distinct calendar months.
--
-- Example:
-- August 18 visit
-- → May 21 through August 18
-- → must have activity in 3+ distinct months
-- ============================================================

returning_visitors AS (

  SELECT
    p.user_id,
    p.visit_date

  FROM (
    SELECT DISTINCT
      user_id,
      visit_date
    FROM pvs
  ) p

  INNER JOIN visitor_activity a
    ON a.user_id = p.user_id
    AND a.activity_date BETWEEN
        p.visit_date - 89
        AND p.visit_date

  GROUP BY
    p.user_id,
    p.visit_date

  HAVING COUNT(
    DISTINCT a.activity_month
  ) >= 3
),


-- ============================================================
-- Step 6: Keep qualifying daily activity
-- ============================================================

new_rows AS (

  SELECT
    p.visit_date,
    'returning visitor' AS entitlement_status,
    p.source,
    MAX(p.xid) AS xid

  FROM pvs p

  INNER JOIN returning_visitors r
    ON r.user_id = p.user_id
    AND r.visit_date = p.visit_date

  GROUP BY
    p.visit_date,
    p.user_id,
    p.source
)


-- ============================================================
-- Step 7: Insert new records without duplicates
-- ============================================================

MERGE INTO gold_us_prod.area_shared_analytics.returning_visitors_tny t

USING new_rows s

ON t.visit_date = s.visit_date
   AND t.source = s.source
   AND (
     t.xid <=> s.xid
   )

WHEN NOT MATCHED THEN

  INSERT (
    visit_date,
    entitlement_status,
    source,
    xid
  )

  VALUES (
    s.visit_date,
    s.entitlement_status,
    s.source,
    s.xid
  );
