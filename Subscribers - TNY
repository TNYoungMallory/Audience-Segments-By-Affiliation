SET ansi_mode = false;


-- ============================================================
-- STEP 1: Create table if it does not already exist
--
-- Grain:
--   1 row per subscriber (amgid)
--   per visit_date
--   per source
--
-- Historical rows are retained permanently.
--
-- amgid_stitched and xid are retained for downstream joins
-- but do NOT define the grain.
-- ============================================================

CREATE TABLE IF NOT EXISTS gold_us_prod.area_shared_analytics.subscribers_tny (

  visit_date DATE,
  entitlement_status STRING,
  source STRING,
  amgid STRING,
  amgid_stitched STRING,
  xid STRING

);


-- ============================================================
-- STEP 2: Build current active subscriber universe
--
-- This universe is used ONLY to determine who is eligible
-- to have new activity added during today's refresh.
--
-- It does NOT affect historical rows already in the table.
-- ============================================================

CREATE OR REPLACE TEMP VIEW current_subscribers AS

WITH cds AS (

    SELECT

      email_md5_hash,

      order_expire_dt AS subscription_last_active_day,

      cancel_dt AS cancel_last_active_day,

      RANK() OVER (
        PARTITION BY
          email_md5_hash,
          magazine_abbr,
          order_expire_dt
        ORDER BY
          order_nbr DESC
      ) AS order_count

    FROM gold_us_prod.consumer_dw.f_consumer_subscription_cds

    WHERE brand_cd IN ('NYR', 'NYR3')
),


active_subs AS (

    -- CDS subscribers
    SELECT DISTINCT
      email_md5_hash

    FROM cds

    WHERE order_count = 1
      AND cancel_last_active_day IS NULL
      AND subscription_last_active_day >= CURRENT_DATE

    UNION

    -- Martech subscribers
    SELECT DISTINCT
      email_md5_hash

    FROM gold_us_prod.consumer_dw.f_consumer_subscription_martech

    WHERE core_brand_cd IN ('TNY', 'NYR')
      AND sub_cancelled_dt IS NULL
)


SELECT DISTINCT

  ext.amg_uuid AS amgid

FROM gold_us_prod.consumer_dw.d_email_extd ext

INNER JOIN active_subs s
  ON ext.email_md5_hash = s.email_md5_hash

WHERE ext.amg_uuid IS NOT NULL;


-- ============================================================
-- STEP 3: Build daily engagement
--
-- WEB:
--   One row per amgid + visit_date
--
-- MOBILE:
--   One row per amgid + visit_date
--
-- The 3-day lookback allows the daily process to safely
-- reprocess recent dates.
--
-- Historical rows already in the table are never deleted.
-- ============================================================

WITH web_ranked AS (

    SELECT

      start_tstamp_date AS visit_date,

      user.amgid AS amgid,

      user.amg_id_stitched AS amgid_stitched,

      user.xid AS xid,

      ROW_NUMBER() OVER (

        PARTITION BY
          start_tstamp_date,
          user.amgid

        ORDER BY
          start_tstamp DESC

      ) AS rn

    FROM gold_us_prod.spruce.gld_web_page_views

    WHERE start_tstamp_date BETWEEN CURRENT_DATE - 3
                                AND CURRENT_DATE - 1

      AND app_id IN (
        'the-new-yorker',
        'the-new-yorker-app'
      )

      AND user.amgid IS NOT NULL

      AND domain_userid IS NOT NULL
),


web_daily AS (

    SELECT

      visit_date,

      amgid,

      amgid_stitched,

      xid,

      'web' AS source

    FROM web_ranked

    WHERE rn = 1
),


mobile_daily AS (

    SELECT

      derived_tstamp_date AS visit_date,

      user.amg_id AS amgid,

      NULL AS amgid_stitched,

      NULL AS xid,

      'mobile' AS source

    FROM gold_us_prod.spruce.gld_mobile_screen_views

    WHERE derived_tstamp_date BETWEEN CURRENT_DATE - 3
                                  AND CURRENT_DATE - 1

      AND app_id = 'the-new-yorker-app'

      AND user.amg_id IS NOT NULL

    GROUP BY

      derived_tstamp_date,
      user.amg_id
),


daily_engagement AS (

    SELECT

      visit_date,
      amgid,
      amgid_stitched,
      xid,
      source

    FROM web_daily

    UNION ALL

    SELECT

      visit_date,
      amgid,
      amgid_stitched,
      xid,
      source

    FROM mobile_daily
),


-- ============================================================
-- STEP 4: Keep only engagement from CURRENT subscribers
--
-- This determines eligibility for NEW rows only.
--
-- If a subscriber later cancels or stops taking action,
-- their existing historical rows remain in the table.
-- ============================================================

new_rows AS (

    SELECT

      d.visit_date,

      'current subscriber' AS entitlement_status,

      d.source,

      d.amgid,

      d.amgid_stitched,

      d.xid

    FROM daily_engagement d

    INNER JOIN current_subscribers cs
      ON d.amgid = cs.amgid
)


-- ============================================================
-- STEP 5: Merge daily engagement into historical table
--
-- Grain:
--   visit_date + amgid + source
--
-- If the row already exists:
--   Update identifiers when a newer/better value is available.
--
-- If the row does not exist:
--   Insert it.
--
-- IMPORTANT:
--   There is intentionally NO DELETE step.
--   Historical subscriber activity is retained permanently.
-- ============================================================

MERGE INTO gold_us_prod.area_shared_analytics.subscribers_tny t

USING new_rows s

ON t.visit_date = s.visit_date

   AND t.amgid = s.amgid

   AND t.source = s.source


WHEN MATCHED THEN

  UPDATE SET

    t.amgid_stitched =
      COALESCE(
        s.amgid_stitched,
        t.amgid_stitched
      ),

    t.xid =
      COALESCE(
        s.xid,
        t.xid
      )


WHEN NOT MATCHED THEN

  INSERT (
    visit_date,
    entitlement_status,
    source,
    amgid,
    amgid_stitched,
    xid
  )

  VALUES (
    s.visit_date,
    s.entitlement_status,
    s.source,
    s.amgid,
    s.amgid_stitched,
    s.xid
  );
