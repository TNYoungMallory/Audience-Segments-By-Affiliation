SET ansi_mode = false;


-- ============================================================
-- STEP 1: Create table if it does not already exist
-- ============================================================

CREATE TABLE IF NOT EXISTS gold_us_prod.area_shared_analytics.subscribers_tny (

  visit_date DATE,
  entitlement_status STRING,
  source STRING,
  amgid STRING,
  amgid_stitched STRING,
  xid STRING

);


-- ============================================================
-- STEP 2: Build current active subscriber universe
-- ============================================================

CREATE OR REPLACE TEMP VIEW current_subscribers AS

WITH cds AS (

    SELECT
      email_md5_hash,
      order_expire_dt AS subscription_last_active_day,
      cancel_dt AS cancel_last_active_day,

      RANK() OVER (
        PARTITION BY email_md5_hash, magazine_abbr, order_expire_dt
        ORDER BY order_nbr DESC
      ) AS order_count

    FROM gold_us_prod.consumer_dw.f_consumer_subscription_cds

    WHERE brand_cd IN ('NYR', 'NYR3')
),

active_subs AS (

    SELECT DISTINCT
      email_md5_hash

    FROM cds

    WHERE order_count = 1
      AND cancel_last_active_day IS NULL
      AND subscription_last_active_day >= CURRENT_DATE

    UNION

    SELECT DISTINCT
      email_md5_hash

    FROM gold_us_prod.consumer_dw.f_consumer_subscription_martech

    WHERE core_brand_cd IN ('TNY', 'NYR')
      AND sub_cancelled_dt IS NULL
)

SELECT DISTINCT
  ext.amg_uuid AS amgid

FROM gold_us_prod.consumer_dw.d_email_extd ext

INNER JOIN active_subs s
  ON ext.email_md5_hash = s.email_md5_hash

WHERE ext.amg_uuid IS NOT NULL;


-- ============================================================
-- STEP 3: Remove people who are no longer current subscribers
-- ============================================================

DELETE FROM gold_us_prod.area_shared_analytics.subscribers_tny

WHERE amgid IS NOT NULL

  AND NOT EXISTS (

    SELECT 1

    FROM current_subscribers cs

    WHERE cs.amgid = subscribers_tny.amgid

  );


-- ============================================================
-- STEP 4: Get daily engaged subscribers
--
-- WEB:
--   One row per subscriber per day
--
-- MOBILE:
--   One row per subscriber per day
-- ============================================================

WITH web_daily AS (

    SELECT

      start_tstamp_date AS visit_date,

      user.amgid AS amgid,

      MAX(user.amg_id_stitched) AS amgid_stitched,

      MAX(user.xid) AS xid,

      'web' AS source

    FROM gold_us_prod.spruce.gld_web_page_views

    WHERE start_tstamp_date BETWEEN CURRENT_DATE - 3
                                AND CURRENT_DATE - 1

      AND app_id IN (
        'the-new-yorker',
        'the-new-yorker-app'
      )

      AND user.amgid IS NOT NULL

      AND domain_userid IS NOT NULL

    GROUP BY
      start_tstamp_date,
      user.amgid
),


mobile_daily AS (

    SELECT

      derived_tstamp_date AS visit_date,

      user.amg_id AS amgid,

      NULL AS amgid_stitched,

      NULL AS xid,

      'mobile' AS source

    FROM gold_us_prod.spruce.gld_mobile_screen_views

    WHERE derived_tstamp_date BETWEEN CURRENT_DATE - 3
                                  AND CURRENT_DATE - 1

      AND app_id = 'the-new-yorker-app'

      AND user.amg_id IS NOT NULL

    GROUP BY
      derived_tstamp_date,
      user.amg_id
),


daily_engagement AS (

    SELECT * FROM web_daily

    UNION ALL

    SELECT * FROM mobile_daily
),


-- ============================================================
-- STEP 5: Keep only currently subscribed users
-- ============================================================

new_rows AS (

    SELECT

      d.visit_date,

      'current subscriber' AS entitlement_status,

      d.source,

      d.amgid,

      d.amgid_stitched,

      d.xid

    FROM daily_engagement d

    INNER JOIN current_subscribers cs
      ON d.amgid = cs.amgid
)


-- ============================================================
-- STEP 6: Insert one row per subscriber / date / source
-- ============================================================

MERGE INTO gold_us_prod.area_shared_analytics.subscribers_tny t

USING new_rows s

ON t.visit_date = s.visit_date

   AND t.amgid = s.amgid

   AND t.source = s.source

WHEN NOT MATCHED THEN

  INSERT (
    visit_date,
    entitlement_status,
    source,
    amgid,
    amgid_stitched,
    xid
  )

  VALUES (
    s.visit_date,
    s.entitlement_status,
    s.source,
    s.amgid,
    s.amgid_stitched,
    s.xid
  );
